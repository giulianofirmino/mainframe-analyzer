       IDENTIFICATION DIVISION.
       PROGRAM-ID. APP1.
       PROCEDURE DIVISION.
           EXEC CICS RECEIVE MAP('MAINMAP') END-EXEC
           MOVE PARM TO TIPO
           IF TIPO = 'M'
              EXEC SQL SELECT STATUS INTO :STATUS FROM CUSTOMER WHERE ID = :CUSTOMER_ID END-EXEC
              EXEC CICS PUT CONTAINER('CID') CHANNEL('CTX') FROM(CUSTOMER_ID) END-EXEC
              EXEC CICS LINK PROGRAM('APP2') END-EXEC
              EXEC CICS GET CONTAINER('CID') CHANNEL('CTX') INTO(CID2) END-EXEC
              EXEC CICS START TRANSID('NEXT') END-EXEC
              EXEC CICS SEND MAP('MAINMAP') END-EXEC
           END-IF.
           GOBACK.
